# The screenshot tests' machine: Ubuntu 22.04 as GitHub's CI runners are,
# with a virtual display (Xvfb) and Mesa's software renderer, so reference
# screenshots made here match the ones CI takes.
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential pkg-config git \
        libxkbcommon-dev libwayland-dev libxkbcommon-x11-0 libx11-xcb1 libxcursor1 libxrandr2 libxi6 \
        xvfb xauth libgl1-mesa-dri libegl1 libgl1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
